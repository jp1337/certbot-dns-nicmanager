# Maintainer: jp1337 <12394156+jp1337@users.noreply.github.com>
# Source of the AUR package certbot-dns-nicmanager; see docs-tech/RELEASING.md.

pkgname=certbot-dns-nicmanager
_name=certbot_dns_nicmanager
pkgver=1.1.3
pkgrel=1
pkgdesc="Certbot DNS-01 plugin for nicmanager AnycastDNS: wildcard Let's Encrypt certificates, API-ACME account, 2FA"
arch=('any')
url="https://github.com/jp1337/certbot-dns-nicmanager"
license=('Apache-2.0')
depends=('certbot' 'python' 'python-pyotp' 'python-requests')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest' 'python-requests-mock')
source=("https://files.pythonhosted.org/packages/source/${_name::1}/${_name}/${_name}-${pkgver}.tar.gz")
sha256sums=('332f028745fd3c05ea0e98657a33cc3ed8fc8ce731a3d915057337bb1639a76a')

build() {
  cd "${_name}-${pkgver}"
  python -m build --wheel --no-isolation
}

check() {
  cd "${_name}-${pkgver}"
  # The coverage options in pyproject.toml need pytest-cov, which Arch does not
  # require here; the docs boundary tests skip themselves outside a git checkout.
  PYTHONPATH="$PWD" pytest -o addopts=""
}

package() {
  cd "${_name}-${pkgver}"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
